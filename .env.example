# Токен бота от @BotFather (отдельный от Defender/OpenClaw)
BOT_TOKEN=

# ID группового чата менеджеров (добавьте бота в группу, узнайте numeric chat id)
MANAGER_GROUP_CHAT_ID=

# Необязательно: ID топика (темы) внутри группы, куда слать "Связь с менеджером".
# Берётся из ссылки на топик вида https://t.me/c/<group>/<topic_id> — это
# число в конце и есть topic_id. Оставьте пустым, чтобы слать в общий поток группы.
MANAGER_GROUP_TOPIC_ID=

# Numeric Telegram ID обоих менеджеров, через запятую (НЕ username)

# ID Google-таблицы (из её URL: https://docs.google.com/spreadsheets/d/ЭТОТ_ID/edit)
SPREADSHEET_ID=

# Путь к JSON-ключу сервисного аккаунта Google
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Секрет для проверки webhook-запросов от Google Apps Script (сгенерируйте
# случайную строку: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Без него webhook-эндпоинты открыты для любого, кто знает ngrok-URL.
WEBHOOK_SECRET=

# Runtime
PORT=3000
TZ=Asia/Tashkent
LOG_LEVEL=info

# PostgreSQL (generate a long random password)
POSTGRES_DB=china_cargo
POSTGRES_USER=china_cargo
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://china_cargo:CHANGE_ME@localhost:5432/china_cargo
DATABASE_SSL=false

# Permanent ngrok domain and account token
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Local retention; additionally copy backups off this PC
BACKUP_RETENTION_DAYS=14
